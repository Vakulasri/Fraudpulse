# Copy this file to .env and fill in your key:   copy .env.example .env
GROQ_API_KEY=your_groq_api_key_here

# Groq retires models over time - check https://console.groq.com/docs/models and change if needed
GROQ_MODEL=llama-3.1-8b-instant

# Max LLM calls per minute (keep below your Groq free-tier limit)
GROQ_MAX_RPM=20

# Where the simulator / load test find the API
API_URL=http://127.0.0.1:8000

# Optional: override the decision threshold chosen during training (leave blank to use it)
FRAUD_THRESHOLD=
